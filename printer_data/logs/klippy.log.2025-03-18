dir_pin = !PA0
enable_pin = !PC3
microsteps = 256
rotation_distance = 7.96
nozzle_diameter = 1.4
filament_diameter = 1.750
heater_pin = PB1
sensor_pin = PF4
sensor_type = ATC Semitec 104GT-2
min_temp = 0
