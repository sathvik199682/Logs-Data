max_extrude_only_velocity = 5
max_extrude_only_accel = 500
pressure_advance = 0.015
pressure_advance_smooth_time = 0.040
control = pid
pid_kp = 35.552
pid_ki = 4.389
pid_kd = 71.993

[tmc2209 extruder]
uart_pin = PD4
run_current = 0.700

[stepper_z1]
step_pin = PD13
dir_pin = !PG9
enable_pin = !PF0
microsteps = 256
rotation_distance = 2

[stepper_y1]
step_pin = PD15
dir_pin = PE7
enable_pin = !PA3
microsteps = 256
rotation_distance = 32

[tmc2209 stepper_y1]
uart_pin = PD1
run_current = 0.700

[safe_z_home]
home_xy_position = 182,150
speed = 60
z_hop = 10
z_hop_speed = 2

[output_pin probe_enable]
pin = PA1
value = 0

[gcode_macro Probe_Deploy]
gcode = 
	SET_PIN PIN=probe_enable VALUE=1

[gcode_macro Probe_Stow]
gcode = 
	SET_PIN PIN=probe_enable VALUE=0

[probe]
pin = ^!PG8
deactivate_on_each_sample = False
x_offset = -42
y_offset = 0
speed = 5
activate_gcode = 
	Probe_Deploy
	G4 P500
deactivate_gcode = 
	Probe_Stow
z_offset = 0.630

[bed_mesh]
speed = 100
horizontal_move_z = 5
mesh_min = 0,0
mesh_max = 322,300
probe_count = 7, 7
mesh_pps = 3, 2
algorithm = bicubic
bicubic_tension = 0.2

[filament_motion_sensor encoder_sensor]
switch_pin = ^PE15
detection_length = 45
extruder = extruder
pause_on_runout = False
runout_gcode = 
	
	M117 Filament encoder runout
insert_gcode = 
	M117 Filament encoder inserted

[input_shaper]
shaper_type_x = mzv
shaper_freq_x = 66.6
shaper_type_y = 2hump_ei
shaper_freq_y = 61.8

[idle_timeout]
timeout = 100000000

[z_tilt]
z_positions = 
	0,150
	365,150
points = 
	42,150
	323,150
speed = 50
horizontal_move_z = 10
retries = 5
retry_tolerance = 0.02

[heater_bed]
heater_pin = PD12
sensor_pin = PF3
sensor_type = ATC Semitec 104GT-2
control = watermark
min_temp = 0
max_temp = 130

[delayed_gcode init_bedmesh]
initial_duration = 5
gcode = 
	BED_MESH_PROFILE LOAD="default"

[fan]
pin = PC8

[fan_generic extruder_partfan]
pin = PE6

[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32f407xx_52004E001950324239333220-if00

[gcode_macro LOAD_FILAMENT]
variable_load_distance = 50
variable_purge_distance = 25
gcode = 
	{% set speed = params.SPEED|default(300) %}
	{% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
	SAVE_GCODE_STATE NAME=load_state
	G91
	G92 E0
	G1 E{load_distance} F{max_velocity}
	G1 E{purge_distance} F{speed}
	RESTORE_GCODE_STATE NAME=load_state

[gcode_macro UNLOAD_FILAMENT]
variable_unload_distance = 50
variable_purge_distance = 25
gcode = 
	{% set speed = params.SPEED|default(300) %}
	{% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
	SAVE_GCODE_STATE NAME=unload_state
	G91
	G92 E0
	G1 E{purge_distance} F{speed}
	G1 E-{unload_distance} F{max_velocity}
	RESTORE_GCODE_STATE NAME=unload_state

[printer]
kinematics = cartesian
square_corner_velocity = 5
max_velocity = 600
max_accel = 6000
max_z_velocity = 2
max_z_accel = 100

[tmc2208 stepper_z]
uart_pin = PE1
run_current = 0.650

[tmc2208 stepper_z1]
uart_pin = PD6
run_current = 0.800

[board_pins]
aliases = 
	
	EXP1_1=PG4, EXP1_3=PD11, EXP1_5=PG2, EXP1_7=PG6, EXP1_9=<GND>,
	EXP1_2=PA8, EXP1_4=PD10, EXP1_6=PG3, EXP1_8=PG7, EXP1_10=<5V>,
	
	EXP2_1=PB14, EXP2_3=PG10, EXP2_5=PF11, EXP2_7=PF12,  EXP2_9=<GND>,
	EXP2_2=PB13, EXP2_4=PB12, EXP2_6=PB15, EXP2_8=<RST>, EXP2_10=PF13

[bed_mesh default]
version = 1
points = 
	-0.486793, -0.507497, -0.514528, -0.308200, -0.305231, -0.293122, 0.066410
	-0.300387, -0.419997, -0.481559, -0.444450, -0.371715, -0.209840, 0.130316
	-0.227106, -0.325075, -0.348981, -0.366403, -0.290700, -0.149918, 0.138753
	-0.003356, -0.213825, -0.253668, -0.045075, -0.103825, -0.090934, 0.171644
	0.055394, -0.068043, -0.162965, -0.114215, -0.133825, -0.018200, 0.193128
	0.000433, -0.106090, -0.187965, -0.173981, -0.108747, -0.050778, 0.185394
	-0.042028, -0.225465, -0.219684, -0.031559, -0.090309, -0.125387, 0.221644
x_count = 7
y_count = 7
mesh_x_pps = 3
mesh_y_pps = 2
algo = bicubic
tension = 0.2
min_x = 0.0
max_x = 321.96
min_y = 0.0
max_y = 300.0
=======================
