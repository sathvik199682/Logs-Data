dir_pin = PE7
enable_pin = !PA3
microsteps = 256
rotation_distance = 32

[tmc2209 stepper_y1]
uart_pin = PD1
run_current = 0.700

[safe_z_home]
home_xy_position = 182,150
speed = 60
z_hop = 10
z_hop_speed = 2

[output_pin probe_enable]
pin = PA1
value = 0

[gcode_macro Probe_Deploy]
gcode = 
	SET_PIN PIN=probe_enable VALUE=1

[gcode_macro Probe_Stow]
gcode = 
	SET_PIN PIN=probe_enable VALUE=0

[probe]
pin = ^!PG8
deactivate_on_each_sample = False
x_offset = -42
y_offset = 0
speed = 5
activate_gcode = 
	Probe_Deploy
	G4 P500
deactivate_gcode = 
	Probe_Stow
z_offset = 0.630

[bed_mesh]
speed = 100
horizontal_move_z = 5
mesh_min = 0,0
mesh_max = 322,300
probe_count = 7, 7
mesh_pps = 3, 2
algorithm = bicubic
bicubic_tension = 0.2

[filament_motion_sensor encoder_sensor]
switch_pin = ^PE15
detection_length = 45
extruder = extruder
pause_on_runout = False
runout_gcode = 
	
	M117 Filament encoder runout
insert_gcode = 
	M117 Filament encoder inserted

[input_shaper]
shaper_type_x = mzv
shaper_freq_x = 66.6
shaper_type_y = 2hump_ei
shaper_freq_y = 61.8

[idle_timeout]
timeout = 100000000

