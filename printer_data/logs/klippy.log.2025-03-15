dir_pin = PE8
enable_pin = !PD7
microsteps = 256
rotation_distance = 32
endstop_pin = !PE12
position_endstop = 0
position_max = 300
homing_speed = 50
second_homing_speed = 5

[tmc2209 stepper_y]
