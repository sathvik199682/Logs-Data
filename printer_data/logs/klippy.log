	-0.370617, -0.442414, -0.478117, -0.277492, -0.290930, -0.294289, 0.088289
	-0.274133, -0.376789, -0.447180, -0.425305, -0.353508, -0.210774, 0.119226
	-0.212961, -0.307492, -0.324602, -0.357492, -0.277492, -0.159446, 0.109070
	-0.010852, -0.224524, -0.263899, -0.047258, -0.106321, -0.088274, 0.175086
