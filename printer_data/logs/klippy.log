[delayed_gcode init_bedmesh]
initial_duration = 5
gcode = 
	BED_MESH_PROFILE LOAD="default"

[fan]
pin = PC8

[fan_generic extruder_partfan]
pin = PE6

[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32f407xx_52004E001950324239333220-if00

[gcode_macro LOAD_FILAMENT]
variable_load_distance = 50
variable_purge_distance = 25
gcode = 
	{% set speed = params.SPEED|default(300) %}
	{% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
	SAVE_GCODE_STATE NAME=load_state
	G91
	G92 E0
	G1 E{load_distance} F{max_velocity}
	G1 E{purge_distance} F{speed}
	RESTORE_GCODE_STATE NAME=load_state

[gcode_macro UNLOAD_FILAMENT]
variable_unload_distance = 50
variable_purge_distance = 25
gcode = 
	{% set speed = params.SPEED|default(300) %}
	{% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
	SAVE_GCODE_STATE NAME=unload_state
	G91
	G92 E0
	G1 E{purge_distance} F{speed}
	G1 E-{unload_distance} F{max_velocity}
	RESTORE_GCODE_STATE NAME=unload_state

[printer]
kinematics = cartesian
square_corner_velocity = 5
max_velocity = 600
max_accel = 6000
max_z_velocity = 2
max_z_accel = 100

[tmc2208 stepper_z]
uart_pin = PE1
run_current = 0.650

[tmc2208 stepper_z1]
uart_pin = PD6
run_current = 0.800

[board_pins]
aliases = 
	
	EXP1_1=PG4, EXP1_3=PD11, EXP1_5=PG2, EXP1_7=PG6, EXP1_9=<GND>,
	EXP1_2=PA8, EXP1_4=PD10, EXP1_6=PG3, EXP1_8=PG7, EXP1_10=<5V>,
	
	EXP2_1=PB14, EXP2_3=PG10, EXP2_5=PF11, EXP2_7=PF12,  EXP2_9=<GND>,
	EXP2_2=PB13, EXP2_4=PB12, EXP2_6=PB15, EXP2_8=<RST>, EXP2_10=PF13

[bed_mesh default]
version = 1
points = 
	-0.486793, -0.507497, -0.514528, -0.308200, -0.305231, -0.293122, 0.066410
	-0.300387, -0.419997, -0.481559, -0.444450, -0.371715, -0.209840, 0.130316
	-0.227106, -0.325075, -0.348981, -0.366403, -0.290700, -0.149918, 0.138753
	-0.003356, -0.213825, -0.253668, -0.045075, -0.103825, -0.090934, 0.171644
	0.055394, -0.068043, -0.162965, -0.114215, -0.133825, -0.018200, 0.193128
	0.000433, -0.106090, -0.187965, -0.173981, -0.108747, -0.050778, 0.185394
	-0.042028, -0.225465, -0.219684, -0.031559, -0.090309, -0.125387, 0.221644
x_count = 7
y_count = 7
mesh_x_pps = 3
mesh_y_pps = 2
algo = bicubic
tension = 0.2
min_x = 0.0
max_x = 321.96
min_y = 0.0
max_y = 300.0
