[gcode_macro POWER_LOSS]
gcode = 
	M118 Power loss detected! Saving position.
	M400
	{% set x_live = printer.motion_report.live_position.x %}
	{% set y_live = printer.motion_report.live_position.y %}
	{% set z_live = printer.motion_report.live_position.z %}
	{% set e_live = printer.motion_report.live_position.e %}
	
	{% set x_gcode = printer.gcode_move.gcode_position.x %}
	{% set y_gcode = printer.gcode_move.gcode_position.y %}
	{% set z_gcode = printer.gcode_move.gcode_position.z %}
	{% set e_gcode = printer.gcode_move.gcode_position.e %}
	
	{% set z_offset = printer.gcode_move.homing_origin.z %}
	
	
	SAVE_VARIABLE VARIABLE=plr_x_live_pos VALUE={x_live}
	SAVE_VARIABLE VARIABLE=plr_y_live_pos VALUE={y_live}
	SAVE_VARIABLE VARIABLE=plr_z_live_pos VALUE={z_live}
	SAVE_VARIABLE VARIABLE=plr_e_live_pos VALUE={e_live}
	SAVE_VARIABLE VARIABLE=plr_x_gcode_pos VALUE={x_gcode}
	SAVE_VARIABLE VARIABLE=plr_y_gcode_pos VALUE={y_gcode}
	SAVE_VARIABLE VARIABLE=plr_z_gcode_pos VALUE={z_gcode}
	SAVE_VARIABLE VARIABLE=plr_e_gcode_pos VALUE={e_gcode}
	SAVE_VARIABLE VARIABLE=plr_z_offset VALUE={z_offset}
	
	
	
	
	
	{% set filepath=printer.virtual_sdcard.file_path %}
	{% set filename=filepath.split('/')%}
	SAVE_VARIABLE VARIABLE=last_file VALUE='"{ filename[-1] }"'
	SAVE_VARIABLE VARIABLE=filepath VALUE='"{ printer.virtual_sdcard.file_path }"'
	
	{% set bed_temp = printer.heater_bed.target %}
	{% set extruder_temp = printer.extruder.target %}
	SAVE_VARIABLE VARIABLE=plr_bed_temp VALUE={bed_temp}
	SAVE_VARIABLE VARIABLE=plr_extruder_temp VALUE={extruder_temp}
	M118 Paused at Live:X={x_live}, Y={y_live}, Z={z_live}, E={e_live} Gcode: X={x_gcode}, Y={y_gcode}, Z={z_gcode}, E={e_gcode}
	
	
	PAUSE
	M400
	M118 Position after paused: Live:X={printer.motion_report.live_position.x}, Y={printer.motion_report.live_position.y}, Z={printer.motion_report.live_position.z}, E={printer.motion_report.live_position.e} Gcode: X={printer.gcode_move.gcode_position.x}, Y={printer.gcode_move.gcode_position.y}, Z={printer.gcode_move.gcode_position.z}, E={printer.gcode_move.gcode_position.e}
	M104 S0
	M140 S0

[gcode_macro RESUME_AFTER_POWER_LOSS]
gcode = 
	
	SAVE_VARIABLE VARIABLE=plr_status VALUE=False
	G4 P1000
	{% set temp = printer.save_variables.variables %}
	{% set plr_status1 = temp.plr_status %}
	M118 Plr status before: {plr_status1}
	
	RUN_SHELL_COMMAND CMD=plr
	
	
	
	
	
	
	
	BED_MESH_PROFILE LOAD=default
	G4 P2000
	
	{% set var = printer.save_variables.variables %}
	
	{% set bed_temp = var.plr_bed_temp %}
	{% set extruder_temp = var.plr_extruder_temp %}
	
	M118 Bed_temp: {bed_temp}
	M118 Extruder_temp: {extruder_temp}
	M140 S{bed_temp}
	M104 S{extruder_temp}
	
	
	M190 S{bed_temp}
	M109 S{extruder_temp}
	
	
	G28 X Y
	
	
	{% set homed_axes = printer.toolhead.homed_axes %}
	
	{% if 'z' in homed_axes %}
	SET_KINEMATIC_POSITION Z={var.plr_z_gcode_pos+var.plr_z_offset}
	{% else %}
	
	
	SET_KINEMATIC_POSITION Z={var.plr_z_gcode_pos-var.plr_z_offset+10+2.0+0.4}
	M118 Z position set to ={var.plr_z_gcode_pos-var.plr_z_offset+10+2.0+0.37}, plr_z ={var.plr_z_gcode_pos}, Z_offset={var.plr_z_offset}, home_z=10.0, pause_z_hop=2.0
	{% endif %}
	
	
	G1 X360 Y290 F5000
	M400
	M83
	G1 E25 F350
	M400
	
	
	
	
	G90
	
	
	
	
	G1 X{var.plr_x_gcode_pos} Y{var.plr_y_gcode_pos} F3000
	G1 Z{var.plr_z_gcode_pos+2} F1000
	M400
	G1 Z{var.plr_z_gcode_pos} F300
	
	M83
	G1 F1000 E0.5
	M400
	G92 E0
	M118 Set extruder to 0
	G1 F200
	M106 S255
	
	
	{% set last_file = printer.save_variables.variables.last_file|default("")|string %}
	M118 Last file: plr/{last_file}
	SDCARD_PRINT_FILE FILENAME="plr/{last_file}"

[gcode_macro TEST_PLR_Z]
gcode = 
	
	RUN_SHELL_COMMAND CMD=plr
	
	BED_MESH_PROFILE LOAD=default
	G4 P2000
	{% set var = printer.save_variables.variables %}
	
	
	{% set bed_temp = var.plr_bed_temp %}
	M118 bed_temp: {bed_temp}
	
	M140 S{bed_temp}
	M190 S{bed_temp}
	
	
	G28 X Y
	
	{% set homed_axes = printer.toolhead.homed_axes %}
	
	{% if 'z' in homed_axes %}
	SET_KINEMATIC_POSITION Z={var.plr_z_gcode_pos+plr_z_offset}
	{% else %}
	SET_KINEMATIC_POSITION Z={var.plr_z_gcode_pos+plr_z_offset+10+1.0}
	{% endif %}
	
	
	G90
	M118 Set extruder to 0
	
	G1 X{var.plr_x_gcode_pos} Y{var.plr_y_gcode_pos} F3000
	G1 Z{var.plr_z_gcode_pos+2} F1000
	M400
	G1 Z{var.plr_z_gcode_pos} F300
	M400
	G4 P10000
	G1 Z{var.plr_z_gcode_pos+2} F300
	
	
	G1 X290 Y290 F5000

[gcode_shell_command plr]
command = sh /home/om/SATHVIK_PLR/plr.sh
timeout = 420.

[gcode_macro GENERATE_PLR_GCODE]
gcode = 
	
	{% set var = printer.save_variables.variables %}
	{% set plr_status = var.plr_status %}
	M118 Plr status before: {plr_status}
	
	RUN_SHELL_COMMAND CMD=plr
	G4 P10000
	M118 Checking
	_CHECK_PLR_STATUS

[gcode_macro _CHECK_PLR_STATUS]
gcode = 
	{% set var1 = printer.save_variables.variables %}
	{% set status = var1.plr_status %}
	M118 Plr status after: {status}
	{% if status == True %}
	M118 Success
	{% else %}
	M118 Failed
	{% endif %}

[save_variables]
filename = /home/om/printer_data/config/variables.cfg

[gcode_button power_loss_detect]
pin = ^rpi:gpio14
press_gcode = 
	
	M118 Pressed Power loss
	
	
	{% if printer.print_stats.state == "printing" %}
	POWER_LOSS
	{% elif printer.idle_timeout.state == "Idle" %}
	M118 Idle Power loss
	{% endif %}
release_gcode = 
	
	M118 Released Power loss

[output_pin power_loss_detect_led]
pin = rpi:gpio15

[force_move]
enable_force_move = True

[stepper_x]
step_pin = PE9
dir_pin = PF1
enable_pin = !PF2
microsteps = 256
rotation_distance = 40
endstop_pin = !PB10
position_endstop = 0
position_max = 365
homing_speed = 50
second_homing_speed = 5

[tmc2209 stepper_x]
uart_pin = PC13
run_current = 0.700

[stepper_y]
step_pin = PE11
dir_pin = PE8
enable_pin = !PD7
microsteps = 256
rotation_distance = 32
endstop_pin = !PE12
position_endstop = 0
position_max = 300
homing_speed = 50
second_homing_speed = 5

[tmc2209 stepper_y]
uart_pin = PE3
run_current = 0.700

[stepper_z]
step_pin = PE13
dir_pin = !PC2
enable_pin = !PC0
microsteps = 256
rotation_distance = 2
endstop_pin = probe:z_virtual_endstop
position_min = -6
position_max = 300
homing_speed = 2

[extruder]
step_pin = PE14
dir_pin = !PA0
enable_pin = !PC3
microsteps = 256
rotation_distance = 7.96
nozzle_diameter = 1.4
filament_diameter = 1.750
heater_pin = PB1
sensor_pin = PF4
sensor_type = ATC Semitec 104GT-2
min_temp = 0
max_temp = 300
max_extrude_only_velocity = 5
max_extrude_only_accel = 500
pressure_advance = 0.015
pressure_advance_smooth_time = 0.040
control = pid
pid_kp = 35.552
pid_ki = 4.389
pid_kd = 71.993

[tmc2209 extruder]
uart_pin = PD4
run_current = 0.700

[stepper_z1]
step_pin = PD13
dir_pin = !PG9
enable_pin = !PF0
microsteps = 256
rotation_distance = 2

[stepper_y1]
step_pin = PD15
dir_pin = PE7
enable_pin = !PA3
microsteps = 256
rotation_distance = 32

[tmc2209 stepper_y1]
uart_pin = PD1
run_current = 0.700

[safe_z_home]
home_xy_position = 182,150
speed = 60
z_hop = 10
z_hop_speed = 2

[output_pin probe_enable]
pin = PA1
value = 0

[gcode_macro Probe_Deploy]
gcode = 
	SET_PIN PIN=probe_enable VALUE=1

[gcode_macro Probe_Stow]
gcode = 
	SET_PIN PIN=probe_enable VALUE=0

[probe]
pin = ^!PG8
deactivate_on_each_sample = False
x_offset = -42
y_offset = 0
speed = 5
activate_gcode = 
	Probe_Deploy
	G4 P500
deactivate_gcode = 
	Probe_Stow
z_offset = 0.630

[bed_mesh]
speed = 100
horizontal_move_z = 5
mesh_min = 0,0
mesh_max = 322,300
probe_count = 7, 7
mesh_pps = 3, 2
algorithm = bicubic
bicubic_tension = 0.2

[filament_motion_sensor encoder_sensor]
switch_pin = ^PE15
detection_length = 45
extruder = extruder
pause_on_runout = False
runout_gcode = 
	
	M117 Filament encoder runout
insert_gcode = 
	M117 Filament encoder inserted

[input_shaper]
shaper_type_x = mzv
shaper_freq_x = 66.6
shaper_type_y = 2hump_ei
shaper_freq_y = 61.8

[idle_timeout]
timeout = 100000000

[z_tilt]
z_positions = 
	0,150
	365,150
points = 
	42,150
	323,150
speed = 50
horizontal_move_z = 10
retries = 5
retry_tolerance = 0.02

[heater_bed]
heater_pin = PD12
sensor_pin = PF3
sensor_type = ATC Semitec 104GT-2
control = watermark
min_temp = 0
max_temp = 130

[delayed_gcode init_bedmesh]
initial_duration = 5
gcode = 
	BED_MESH_PROFILE LOAD="default"

[fan]
pin = PC8

[fan_generic extruder_partfan]
pin = PE6

[mcu]
serial = /dev/serial/by-id/usb-Klipper_stm32f407xx_52004E001950324239333220-if00

[gcode_macro LOAD_FILAMENT]
variable_load_distance = 50
variable_purge_distance = 25
gcode = 
	{% set speed = params.SPEED|default(300) %}
	{% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
	SAVE_GCODE_STATE NAME=load_state
	G91
	G92 E0
	G1 E{load_distance} F{max_velocity}
	G1 E{purge_distance} F{speed}
	RESTORE_GCODE_STATE NAME=load_state

[gcode_macro UNLOAD_FILAMENT]
variable_unload_distance = 50
variable_purge_distance = 25
gcode = 
	{% set speed = params.SPEED|default(300) %}
	{% set max_velocity = printer.configfile.settings['extruder'].max_extrude_only_velocity  * 60 %}
	SAVE_GCODE_STATE NAME=unload_state
	G91
	G92 E0
	G1 E{purge_distance} F{speed}
	G1 E-{unload_distance} F{max_velocity}
	RESTORE_GCODE_STATE NAME=unload_state

[printer]
kinematics = cartesian
square_corner_velocity = 5
max_velocity = 600
max_accel = 6000
max_z_velocity = 2
max_z_accel = 100

[tmc2208 stepper_z]
uart_pin = PE1
run_current = 0.650

[tmc2208 stepper_z1]
uart_pin = PD6
run_current = 0.800

