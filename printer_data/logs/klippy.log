	G4 P3000
	
	M118 Speed: 18000
	G4 P500
	G0 F18000
	G0 X50 Y50
	G0 X50 Y200
	G0 X200 Y200
	G0 X200 Y50
	G0 X50 Y50
	M400
	G4 P3000
	
	M118 Speed: 20000
	G4 P500
