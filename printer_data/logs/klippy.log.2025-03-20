horizontal_move_z = 5
mesh_min = 0,0
mesh_max = 322,300
probe_count = 7, 7
mesh_pps = 3, 2
algorithm = bicubic
bicubic_tension = 0.2

[filament_motion_sensor encoder_sensor]
switch_pin = ^PE15
detection_length = 45
extruder = extruder
pause_on_runout = False
runout_gcode = 
	
	M117 Filament encoder runout
insert_gcode = 
	M117 Filament encoder inserted

[input_shaper]
